# ================================================================
# Database Configuration
# ================================================================
# For production PostgreSQL (Supabase, Neon, AWS RDS):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# For local development with zero setup (SQLite):
DATABASE_URL="file:./dev.db"

# ================================================================
# Admin Authentication Secret
# ================================================================
# Set your secure admin password for logging in to /admin
# (Do NOT commit your real secret to Git)
ADMIN_SECRET="your-own-random-secret"
ADMIN_SECRET_KEY="your-own-random-secret"

# ================================================================
# Application Base URL
# ================================================================
NEXT_PUBLIC_APP_URL="https://wallpc.app"

# ================================================================
# Production Object Storage (Choose one for production Vercel)
# ================================================================
# 1. Vercel Blob (Recommended for Vercel)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# 2. Supabase Storage
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="wallpapers"

# 3. S3-compatible (Cloudflare R2 / AWS S3)
# S3_BUCKET="wallpc-wallpapers"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="your-s3-access-key-id"
# S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
# S3_PUBLIC_DOMAIN="https://cdn.wallpc.app"

